    [[ -z "$1" ]] && {
        echo -e "${ECHO_RET1}in file://$fn_nm , line=${LINENO} :: ARG_1_NOT_DEFINE is name gig dir, return 1${NRM}" >&2
        return 1
    }

    cd ${dr_pth_{fn_nm}} || return 1
    local dr_1_{fn_nm}=${dr_pth_{fn_nm}}/${arg_1_{fn_nm}}
    # local fl_1_{fn_nm}=${dr_pth_{fn_nm}}/${arg_1_{fn_nm}}

    cp -r ${dr_pth_{fn_nm}}/.d ${dr_1_{fn_nm}} || return 1
    lfoe_gig_sh ${dr_1_{fn_nm}} start_make.sh || return 1

    l_02_fs2f ${dr_pth_{fn_nm}}/gig_make_dr.dta/start_make.sh.body "{{body}}" ${dr_1_{fn_nm}}/start_make.sh
    l_02_s2f "{{body}}" "[[body]]" ${dr_1_{fn_nm}}/start_make.sh

    l_02_fs2f ${HOME}/edu_clng/.d/.osdn/.hnt/makefile.body.hnt "{{body}}" ${dr_1_{fn_nm}}/makefile
    l_02_s2f "{{body}}" "[[body]]" ${dr_1_{fn_nm}}/makefile

    l_02_fs2f ${HOME}/edu_clng/.d/.osdn/.hnt/clang.body.hnt "{{body}}" ${dr_1_{fn_nm}}/all.c
    l_02_s2f "{{body}}" "[[body]]" ${dr_1_{fn_nm}}/all.c

    cd ${dr_1_{fn_nm}}

    . start_make.sh