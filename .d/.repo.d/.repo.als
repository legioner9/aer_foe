#!/usr/bin/bash

alias dkr="docker"

alias dkr_container="docker container"

alias dkr_container_run="docker container run"
alias dkr_container_run_h="echo создание контейнера и его запуск"

alias dkr_container_create="docker container create"
alias dkr_container_create_h="echo создание контейнера из образа"

alias dkr_container_start="docker container start"
alias dkr_container_ls="docker container ls"
alias dkr_container_inspect="docker container inspect"
alias dkr_container_logs="docker container logs"
alias dkr_container_stop="docker container stop"
alias dkr_container_kill="docker container kill"
alias dkr_container_rm="docker container rm"

alias dkr_image="docker image"
alias dkr_image_build="docker image build"
alias dkr_image_push="docker image push"
alias dkr_image_ls="docker image ls"
alias dkr_image_history="docker image history"
alias dkr_image_rm="docker image rm"

