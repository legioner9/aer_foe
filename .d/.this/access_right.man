# * gig group
sudo groupadd gitf
# * check exist group
getent group | grep gitf
# * add user to group
sudo usermod -aG gitf $USER
# * do group owner of dr
sudo chgrp -R gitf /run/media/stl/TOSH/new_bare/
or
sudo chown :gitf /run/media/stl/TOSH/new_bare/
# * add right to wright (chmod g - gr)
sudo chmod -R g+w /run/media/stl/TOSH/new_bare/
# ! main command
sudo chown -R $USER /run/media/stl/TOSH/new_bare/

